# Generate a strong random value, e.g. python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace-with-a-long-random-secret
# Set true only when HTTPS is enabled
COOKIE_SECURE=true
# Local PC: SMTP probe is enabled by default. Cloud hosting may block outbound port 25.
# Set false to disable SMTP checks, or true only where outbound SMTP is permitted.
ENABLE_SMTP_CHECK=true
# Safe starting points; adjust only after measuring real test batches.
DNS_TIMEOUT=6
SMTP_TIMEOUT=12
SMTP_RETRIES=2
SMTP_RETRY_DELAY=1.5
MAX_MX_TO_TRY=3
EMAIL_WORKERS=3
MAX_CONCURRENT_SMTP=2
# Optional: set only an SMTP envelope sender address you control. Blank uses <>.
SMTP_MAIL_FROM=
SMTP_POLICY_CACHE_TTL=21600
DISPOSABLE_CACHE_TTL=21600
QUEUE_POLL_SECONDS=2
MAX_UPLOAD_MB=10
# For production, use a persistent volume or set DATABASE_PATH to a durable database path.
# DATABASE_PATH=/data/mailcheck.db
